{
  "$schema": "http://json.schemastore.org/template",
  "author": "pobochniy",
  "classifications": ["Web", "API", "Angular"],
  "name": "Pet Project Template",
  "description": "Full-stack template: ASP.NET Core API + Angular frontend",
  "identity": "pobochniy.PetTemplate",
  "version": "2.0.0",
  "shortName": "pet",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "PetTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "domain": {
      "type": "parameter",
      "datatype": "text",
      "description": "Домен проекта: заменяет example.com в nginx, certbot, workflow, appsettings, клиенте, письмах и документации (adminka.example.com, grafana.example.com — вместе с ним)",
      "defaultValue": "example.com",
      "replaces": "example.com"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".git/**",
            ".idea/**",
            ".claude/settings.local.json",
            ".claude/worktrees/**",
            "**/bin/**",
            "**/obj/**",
            "**/.DS_Store",
            "**/*.DotSettings.user",
            "plan/**",
            "src/PetTemplate.Web/web/node_modules/**",
            "src/PetTemplate.Web/web/.angular/**",
            "src/PetTemplate.Web/web/dist/**",
            "src/PetTemplate.Web/web/out-tsc/**",
            "src/PetTemplate.Web/web/coverage/**",
            "out/**",
            ".artifacts-tests/**",
            "efbundle",
            "tests.log",
            "tests.exit",
            "IaC/nginx/conf/admin-allow.inc",
            "IaC/nginx/conf/admin-allow-open.inc",
            "IaC/.env",
            ".template.config/**"
          ]
        }
      ]
    }
  ]
}
