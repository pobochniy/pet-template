# Database configuration. Пароли читаются только при первом старте Postgres на пустом
# томе db-data (IaC/DEPLOYMENT.md, раздел 2)
POSTGRES_DB=pettemplatedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
# Пользователь приложения — под ним ходит API (секрет API_DB_CONNECTION_STRING), только DML
APP_DB_USER=pettemplate_app
APP_DB_PASSWORD=change_me_app_password
# Владелец базы — под ним выкатка накатывает миграции (секрет MIGRATIONS_DB_CONNECTION_STRING)
APP_DB_OWNER=pettemplate_owner
APP_DB_OWNER_PASSWORD=change_me_owner_password

# Порты
# DB_PORT=5432   # только если раскомментирован ports у database (на 127.0.0.1)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Qdrant — только на 127.0.0.1 (DEPLOYMENT.md, раздел 4)
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Эмбеддер поиска (DEPLOYMENT.md, раздел 4, «Модель эмбеддера»). Пусто — multilingual-e5-small
# в Q8; другая модель — вместе с SearchOptions и полным реиндексом (tech-debt/embeddings-model.md)
# EMBEDDINGS_REPO=TwinSunsLLC/multilingual-e5-small-gguf
# EMBEDDINGS_FILE=multilingual-e5-small-q8_0.gguf

# Телеметрия (DEPLOYMENT.md, раздел 11) — профиль compose: `docker compose up -d` поднимает
# её вместе со всем. Пусто — без телеметрии (Grafana, Prometheus, Tempo, экспортёры)
COMPOSE_PROFILES=observability
# Пароль экспортёра — пользователя postgres-exporter
# в базе (роль pg_monitor, «Метрики PostgreSQL, Qdrant и машины»; postgres/init/02-exporter-user.sh
# заводит его на пустом томе). Токен бота тревог — «Тревоги в Telegram»; пока доставка
# не включена — пустой
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=change_me_exporter_password
TELEGRAM_BOT_TOKEN=
