{
  "uid": "pettemplate-queue",
  "title": "Очередь команд",
  "tags": [
    "pettemplate",
    "localqueue"
  ],
  "timezone": "browser",
  "description": "Метрики очереди — CommandQueueMetrics (AddCommandQueueInstrumentation в Program.cs), имена как у LocalQueue.OpenTelemetry",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Длина очереди",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max by (commandType) ({__name__=~\"local_command_queue_length.*\", commandType=~\"$command\"}), \"command\", \"$1\", \"commandType\", \".*\\\\.([^.]+)\")",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Команд в очереди по типу: ждут воркера или повтора"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Выполнено в минуту",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(sum by (commandType) (rate({__name__=~\"local_command_queue_completed.*\", commandType=~\"$command\"}[$__rate_interval])) * 60, \"command\", \"$1\", \"commandType\", \".*\\\\.([^.]+)\")",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "heatmap",
      "title": "Задержка: от постановки до выполнения",
      "description": "Сколько команда прожила от постановки в очередь до выполнения — ожидание воркера плюс обработка",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "expr": "sum by (le) (rate({__name__=~\"local_command_queue_processing_lag.*_bucket\", commandType=~\"$command\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "fill": "dark-orange",
          "reverse": false
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": false
        },
        "rowsFrame": {
          "layout": "ge"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "type": "heatmap",
      "title": "Время обработки",
      "description": "Сколько работал обработчик",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "range": true,
          "expr": "sum by (le) (rate({__name__=~\"local_command_queue_processing_time.*_bucket\", commandType=~\"$command\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64,
          "fill": "dark-orange",
          "reverse": false
        },
        "filterValues": {
          "le": 1e-09
        },
        "legend": {
          "show": false
        },
        "rowsFrame": {
          "layout": "ge"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Задержка, p95 по типу",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, commandType) (rate({__name__=~\"local_command_queue_processing_lag.*_bucket\", commandType=~\"$command\"}[$__rate_interval]))), \"command\", \"$1\", \"commandType\", \".*\\\\.([^.]+)\")",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Время обработки, p95 по типу",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, commandType) (rate({__name__=~\"local_command_queue_processing_time.*_bucket\", commandType=~\"$command\"}[$__rate_interval]))), \"command\", \"$1\", \"commandType\", \".*\\\\.([^.]+)\")",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Попыток у самой упрямой команды",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(max by (commandType) ({__name__=~\"local_command_queue_max_try_count.*\", commandType=~\"$command\"}), \"command\", \"$1\", \"commandType\", \".*\\\\.([^.]+)\")",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Максимум TryCount среди команд в очереди: больше 1 — команда падала и ждёт повтора"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "command",
        "label": "Команда",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values({__name__=~\"local_command_queue_length.*\"}, commandType)",
        "query": {
          "query": "label_values({__name__=~\"local_command_queue_length.*\"}, commandType)",
          "refId": "cmd"
        },
        "regex": "^(?=.*?(?<text>[^\\.]+$))(?<value>.+)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}
