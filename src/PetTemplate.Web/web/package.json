{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "i18n": "node tools/i18n-codegen.mjs",
    "i18n:check": "node tools/i18n-codegen.mjs --check",
    "i18n:lint": "node tools/i18n-lint.mjs",
    "i18n:codes": "node tools/i18n-server-codes.mjs",
    "lint:storage": "node tools/storage-lint.mjs",
    "enum:parity": "node tools/enum-parity.mjs",
    "api:types": "node tools/api-types.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "csp:hash": "node tools/csp-hash.mjs",
    "prestart": "npm run i18n",
    "start": "ng serve pet-template",
    "prebuild": "npm run i18n",
    "build": "ng build pet-template",
    "watch": "ng build pet-template --watch --configuration development",
    "pretest": "npm run i18n",
    "test": "ng test pet-template",
    "start:admin": "ng serve admin",
    "build:admin": "ng build admin",
    "test:admin": "ng test admin --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "bootstrap": "^5.3.8",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
