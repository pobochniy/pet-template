<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="pobhub" value="https://nuget.pkg.github.com/pobochniy/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <pobhub>
      <add key="Username" value="%NUGET_GITHUB_USER%" />
      <add key="ClearTextPassword" value="%NUGET_GITHUB_TOKEN%" />
    </pobhub>
  </packageSourceCredentials>
  <!-- В закрытый фид ходим только за пакетами очереди: остальное restore берёт с nuget.org
       и не стучится в pobhub. Пока шаблон пакетов очереди не использует, сборка проходит
       и без NUGET_GITHUB_TOKEN; появятся — без токена restore упадёт с 401 (README, «Пакеты из закрытого фида»). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="pobhub">
      <package pattern="localqueue" />
      <package pattern="LocalQueue.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
