## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

/packages/
riderModule.iml
/_ReSharper.Caches/
.idea/
*.DotSettings.user
.DS_Store

# Публикация `dotnet publish -o out` — артефакт, не код
out/

# Личные рабочие файлы в корне (нарезка задачи, открытые вопросы, ревью) — не коммитятся
/plan/

# фоновый прогон тестов из publish-api workflow
.artifacts-tests/
tests.log
tests.exit

# Разрешённые адреса админки — только на сервере (IaC/nginx/conf/admin-allow.inc.example)
IaC/nginx/conf/admin-allow.inc
# Открытие админки на время — его пишет и стирает workflow Admin Access
IaC/nginx/conf/admin-allow-open.inc
# Claude Code: личные настройки — у каждого свои; skills в .claude/skills — общие, в репозитории
.claude/settings.local.json
# Claude Code: worktrees агентов — рабочие копии, не код
.claude/worktrees/

# Бандл миграций выкатки (publish-api.yml)
efbundle
